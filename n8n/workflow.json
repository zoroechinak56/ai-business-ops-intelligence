      "name": "Run Analytics Pipeline",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        480,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "id": "ce66d566-3100-4f3a-ac63-0ea5de4769db",
      "name": "Wait Before One Retry",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        720,
        500
      ],
      "webhookId": "business-ops-pipeline-retry"
    },
    {
      "parameters": {
        "command": "python -m src.automation.run_pipeline --file \"{{$node['Webhook Trigger'].json.body.filePath}}\""
      },
      "id": "52cb2a3e-b226-45d2-966f-e7616ee9cba0",
      "name": "Retry Analytics Pipeline Once",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        960,
        500
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.stdout;\nif (typeof raw !== 'string') throw new Error('Pipeline did not return JSON on stdout.');\nconst result = JSON.parse(raw.trim());\nif (!result || typeof result.status !== 'string' || !Array.isArray(result.alerts)) {\n  throw new Error('Pipeline JSON is missing status or alerts.');\n}\nreturn [{ json: result }];"
      },
      "id": "9efed0d7-cc05-42f2-9408-f1e89bbcd194",
      "name": "Parse Pipeline JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-alerts",
              "leftValue": "={{ $json.alerts.length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1d8f2865-6214-4ae2-a25b-ffbef8e84a66",
      "name": "Any Alerts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.PIPELINE_ALERT_FROM }}",
        "toEmail": "={{ $env.PIPELINE_ALERT_TO }}",
        "subject": "Business operations pipeline alert",
        "emailFormat": "text",
        "text": "={{ $json.alerts.map(alert => alert.message).join('\\n') }}",
        "options": {}
      },
      "id": "901c47c3-c175-4a13-89d7-70744c16ba87",
      "name": "Send Threshold Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1680,
        180
      ],
      "credentials": {
        "smtp": {
          "id": "configure-smtp-credentials",
          "name": "Configure SMTP"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO audit_log (run_id, step, status, started_at, ended_at, rows_processed, message) VALUES ($1, $2, $3, $4, $5, $6, $7) RETURNING run_id, step, status, message;",
        "options": {
          "queryReplacement": "={{ [String($execution.id).slice(0, 36), 'n8n_pipeline', $json.status, $now.toISO(), $now.toISO(), 0, JSON.stringify($json)] }}"
        }
      },
      "id": "ef76556b-f631-4812-b85a-7f05bc63692c",
      "name": "Audit Pipeline Completion",
